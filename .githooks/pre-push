#!/bin/sh
# Pre-push guard for session-handoff.
# Runs the test suite before any push so a red/malformed change (e.g. the
# ".1.9.1" leading-dot semver typo that once shipped to main with red CI)
# is caught locally and the push is aborted BEFORE it reaches the remote.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Override in a genuine emergency:
#   git push --no-verify

# Git exports GIT_DIR, GIT_INDEX_FILE and friends into every hook, and `cwd` does not
# override them. The suite spawns git inside fixture repos; inheriting these makes those
# fixtures write into THIS repo. Observed 2026-08-07: a green push left core.bare=true,
# a fixture identity and a fixture commit on the pushed branch ref, and an empty index.
# The tests scrub GIT_* themselves now; this is the second layer, for anything they spawn.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
      GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "pre-push: running test suite…"
if ! npm test; then
  echo ""
  echo "✗ tests failed — push aborted. Fix the failures, or use 'git push --no-verify' to override."
  exit 1
fi
echo "✓ tests passed — proceeding with push"
exit 0
